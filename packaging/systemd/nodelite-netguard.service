[Unit]
StartLimitIntervalSec=60
StartLimitBurst=20
Description=NodeLite device limit guard
After=network-online.target
Wants=network-online.target
Before=nodelite-panel.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/opt/nodelite/config/nodelite.env
ExecStart=/opt/nodelite/bin/nodelite-netguard daemon
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=nodelite
RuntimeDirectory=nodelite
RuntimeDirectoryMode=0770
ReadWritePaths=/run/nodelite
ReadOnlyPaths=/var/lib/nodelite
InaccessiblePaths=/opt/nodelite/data

[Install]
WantedBy=multi-user.target
