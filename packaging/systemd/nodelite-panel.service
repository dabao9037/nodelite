[Unit]
Description=NodeLite panel (loopback only)
After=network-online.target nodelite-netguard.service
Wants=network-online.target nodelite-netguard.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/opt/nodelite/config/nodelite.env
ExecStart=/opt/nodelite/bin/nodelite-panel
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=nodelite
ReadWritePaths=/var/lib/nodelite
RuntimeDirectory=nodelite
RuntimeDirectoryMode=0770
ReadWritePaths=/opt/nodelite/data /opt/nodelite/xray-config
ReadWritePaths=/run/nodelite

[Install]
WantedBy=multi-user.target
