[Unit]
Description=NodeLite random-path gateway
After=network-online.target nodelite-panel.service
Wants=network-online.target nodelite-panel.service

[Service]
# systemd 219（CentOS 7）不认 [Unit] 里的 StartLimit*，
# 旧名字放在 [Service] 段新旧版本都能解析。
StartLimitInterval=60
StartLimitBurst=20
Type=simple
User=root
Group=root
EnvironmentFile=/opt/nodelite/config/nodelite.env
ExecStart=/opt/nodelite/bin/nodelite-gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
