[Unit]
Description=NodeLite Xray Core
# Editing a device limit restarts Xray. systemd's default rate limit (5 starts
# per 10s) would then refuse to start it at all and surface
# "start of the service was attempted too often", which looks like a device
# limit failure even though the config is valid. Allow more attempts and let
# the counter drain on its own.
StartLimitIntervalSec=60
StartLimitBurst=20
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/opt/nodelite/bin/xray run -test -config /opt/nodelite/xray-config/config.json
ExecStart=/opt/nodelite/bin/xray run -config /opt/nodelite/xray-config/config.json
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/opt/nodelite/xray-config

[Install]
WantedBy=multi-user.target
